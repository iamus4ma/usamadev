{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/experiments/pixel-pong/fullscreen",
      "destination": "/app-shell.html"
    },
    {
      "source": "/experiments/udev-technologies/fullscreen",
      "destination": "/app-shell.html"
    },
    {
      "source": "/experiments",
      "destination": "/experiments.html"
    },
    {
      "source": "/experiments/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/experience",
      "destination": "/experience.html"
    }
  ],
  "redirects": [
    {
      "source": "/experiments.html",
      "destination": "/experiments",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/experience.html",
      "destination": "/experience",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/experiments/:slug/fullscreen",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
