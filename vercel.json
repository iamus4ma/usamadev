{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/experiments/pixel-pong/fullscreen",
      "destination": "/index.html"
    },
    {
      "source": "/experiments/udev-technologies/fullscreen",
      "destination": "/index.html"
    },
    {
      "source": "/experiments",
      "destination": "/index.html"
    },
    {
      "source": "/experiments/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/experience",
      "destination": "/experience.html"
    }
  ]
}
